---
/**
 * 01 — Formats. Six cards, one per AdMob format, each with a small phone that
 * tells its format's story in a 4.8 s loop — the "Format cards in motion"
 * board of the design canvas:
 *
 *   banner                 the feed scrolls under an anchored banner, which
 *                          arrives, holds, and refreshes with a sheen;
 *   interstitial           the ad slides up over the app at a natural break,
 *                          the close control lands, a tap dismisses it;
 *   rewarded               a progress bar and timer run 0:15 → 0:00, then the
 *                          reward pops;
 *   rewarded interstitial  an intro card counts in 3, 2, 1 with Skip, grows
 *                          into the ad, then pays the reward;
 *   app-open               the app drops to the home screen; tapping it back
 *                          shows the splash ad first; Continue returns;
 *   native                 the ad card scrolls with the feed, its media loads
 *                          like the app's own content, the CTA pulses once.
 *
 * All six loop together as a wave in reading order, each card 0.8 s behind the
 * one before it, so the big moments ripple across the grid and never land in
 * unison (landing.css, "format stories"). At rest every phone shows its still
 * illustration: under prefers-reduced-motion, in print, without script, and
 * once the motion switch below the grid is paused.
 *
 * Every card is a plain link to its format guide. The phones are decorative
 * (aria-hidden); the card text carries the meaning.
 */
import { formats } from '../../data/landing';
import LandingMotionToggle from './LandingMotionToggle.astro';
import '../../styles/landing.css';

const feed = (count: number) => Array.from({ length: count }, (_, i) => i);
---

<section class="landing-section" aria-labelledby="landing-formats-title">
  <div class="landing-section__head">
    <div class="landing-section__title">
      <p class="landing-eyebrow">01 — Formats</p>
      <h2 id="landing-formats-title">Every AdMob format.<br class="landing-br" /> One call each.</h2>
    </div>
    <p class="landing-section__lede">
      Composables for the ads that live in your layout, controllers for the ones that take the
      screen. The orange region is where the ad lands.
    </p>
  </div>

  <ol class="landing-formats">
    {
      formats.map((format) => (
        <li class="landing-format">
          <a class="landing-format__card" href={format.href} data-format={format.slug}>
            <span class="landing-format__phone" aria-hidden="true">
              <span class={`landing-format__screen landing-format__screen--${format.slug}`}>
                {format.slug === 'banner' && (
                  <>
                    <span class="landing-story__head"><span class="landing-format__bar" /></span>
                    <span class="landing-story__feed landing-story__feed--scroll">
                      {feed(9).map(() => <span class="landing-format__block" />)}
                    </span>
                    <span class="landing-format__ad landing-story__banner">
                      <span class="landing-story__sheen" />
                    </span>
                  </>
                )}
                {format.slug === 'interstitial' && (
                  <>
                    <span class="landing-story__head"><span class="landing-format__bar" /></span>
                    <span class="landing-story__feed">
                      {feed(6).map(() => <span class="landing-format__block" />)}
                    </span>
                    <span class="landing-format__ad landing-story__takeover landing-story__takeover--dismissible">
                      <span class="landing-format__close">
                        <span class="landing-story__tap" />×
                      </span>
                      <span class="landing-format__creative" />
                    </span>
                  </>
                )}
                {format.slug === 'rewarded' && (
                  <>
                    <span class="landing-format__ad landing-story__takeover">
                      <span class="landing-story__progress"><span class="landing-story__fill" /></span>
                      <span class="landing-story__timer">
                        <span class="landing-story__time landing-story__time--1">0:15</span>
                        <span class="landing-story__time landing-story__time--2">0:10</span>
                        <span class="landing-story__time landing-story__time--3">0:05</span>
                        <span class="landing-story__time landing-story__time--4">0:00</span>
                      </span>
                      <span class="landing-format__creative" />
                    </span>
                    <span class="landing-story__sparks">
                      <span class="landing-story__spark landing-story__spark--1" />
                      <span class="landing-story__spark landing-story__spark--2" />
                      <span class="landing-story__spark landing-story__spark--3" />
                      <span class="landing-story__spark landing-story__spark--4" />
                    </span>
                    <span class="landing-story__reward">+1 reward</span>
                  </>
                )}
                {format.slug === 'rewarded-interstitial' && (
                  <>
                    <span class="landing-story__head"><span class="landing-format__bar" /></span>
                    <span class="landing-story__feed">
                      {feed(6).map(() => <span class="landing-format__block" />)}
                    </span>
                    <span class="landing-format__ad landing-story__intro-card">
                      <span class="landing-story__intro">
                        <span class="landing-format__line landing-format__line--ink" />
                        <span class="landing-format__line landing-format__line--muted" />
                        <span class="landing-story__count">
                          <span class="landing-story__count-step landing-story__count-step--3">in 3…</span>
                          <span class="landing-story__count-step landing-story__count-step--2">in 2…</span>
                          <span class="landing-story__count-step landing-story__count-step--1">in 1…</span>
                        </span>
                        <span class="landing-story__skip">Skip</span>
                      </span>
                      <span class="landing-story__full">
                        <span class="landing-format__creative" />
                      </span>
                    </span>
                    <span class="landing-story__reward landing-story__reward--late">+1 reward</span>
                  </>
                )}
                {format.slug === 'app-open' && (
                  <>
                    <span class="landing-story__home">
                      {feed(9).map((i) => (
                        <span class:list={['landing-story__app-icon', i === 4 && 'landing-story__app-icon--ours']} />
                      ))}
                    </span>
                    <span class="landing-story__app">
                      <span class="landing-story__head"><span class="landing-format__bar" /></span>
                      <span class="landing-story__feed">
                        {feed(6).map(() => <span class="landing-format__block" />)}
                      </span>
                    </span>
                    <span class="landing-format__ad landing-story__splash">
                      <span class="landing-format__logo" />
                      <span class="landing-format__continue">Continue to app ›</span>
                    </span>
                  </>
                )}
                {format.slug === 'native' && (
                  <>
                    <span class="landing-story__head"><span class="landing-format__bar" /></span>
                    <span class="landing-story__feed landing-story__feed--native">
                      {feed(3).map(() => (
                        <>
                          <span class="landing-format__block landing-format__block--short" />
                          <span class="landing-format__ad landing-format__ad--native">
                            <span class="landing-format__media">
                              <span class="landing-story__sheen landing-story__sheen--media" />
                            </span>
                            <span class="landing-format__line landing-format__line--ink" />
                            <span class="landing-format__line landing-format__line--muted" />
                            <span class="landing-format__button" />
                          </span>
                          <span class="landing-format__block landing-format__block--short" />
                          <span class="landing-format__block landing-format__block--short" />
                        </>
                      ))}
                    </span>
                  </>
                )}
              </span>
            </span>
            <div class="landing-format__text">
              <h3 class="landing-format__name">{format.name}</h3>
              <p class="landing-format__blurb">{format.blurb}</p>
              <code class="admob-font-mono landing-format__call" title={format.api}>{format.call}</code>
            </div>
          </a>
        </li>
      ))
    }
  </ol>
  <LandingMotionToggle />
</section>

