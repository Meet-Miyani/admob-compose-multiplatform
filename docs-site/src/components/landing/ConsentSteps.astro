---
/**
 * The consent ordering as three steps on a dark panel: gather consent, ask for
 * tracking, initialize. This is the part hand-rolled integrations get wrong,
 * so it gets its own band rather than a paragraph.
 *
 * The full sequence diagram still ships on the page — CompatibilityList renders
 * InitSequence once, as the test contract requires. This band is the summary a
 * reader takes away; the diagram is the proof for the ones who open it.
 *
 * The steps reveal in order as the band scrolls into view (translate only, per
 * the DESIGN.md scroll-animation trap), and not at all under reduced motion.
 */
import '../../styles/landing.css';

const steps = [
  {
    title: 'Gather consent',
    body: 'UMP decides whether ads may be requested at all. canRequestAds gates every request on both platforms.',
    api: 'consent.gatherConsent(config)',
    platform: undefined,
  },
  {
    title: 'Ask for tracking',
    body: 'ATT on iOS 14.5+. Android reports NotApplicable, so shared code never branches on the platform.',
    api: 'tracking.requestAuthorization()',
    platform: 'iOS',
  },
  {
    title: 'Initialize',
    body: 'Mobile Ads starts only once both answers are in. Status comes back as a StateFlow.',
    api: 'AdManagerStatus.Ready',
    platform: undefined,
  },
];
---

<section class="landing-section landing-consent" aria-labelledby="consent-order">
  <div class="landing-heading landing-heading--split">
    <div>
      <p class="landing-eyebrow">02 · Consent</p>
      <h2 id="consent-order">
        Consent, then ATT, then ads. <span class="landing-consent__accent">In that order.</span>
      </h2>
    </div>
    <p class="landing-consent__lede">
      One call runs the whole sequence. Each step stays public if you need to own it.
    </p>
  </div>

  <ol class="landing-consent__steps">
    {steps.map((step, index) => (
      <li class="landing-consent__step">
        <span class="landing-consent__number" aria-hidden="true">0{index + 1}</span>
        <h3 class="landing-consent__title">
          {step.title}
          {step.platform && <span class="landing-consent__platform">{step.platform} only</span>}
        </h3>
        <p class="landing-consent__body">{step.body}</p>
        <code class="admob-font-mono landing-consent__api">{step.api}</code>
      </li>
    ))}
  </ol>

  <p class="landing-consent__warning">
    Requesting ads before ATT resolves permanently forfeits the IDFA. The SDK will not let the
    first request race the prompt.
  </p>
</section>
