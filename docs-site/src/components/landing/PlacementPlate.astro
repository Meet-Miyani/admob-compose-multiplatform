---
/**
 * The placement plate — the landing page's signature element.
 *
 * Two parts. The stage is a dark panel holding the `commonMain` code and the
 * two phones it renders on, Android and iOS, each drawn at a true 9:19.5
 * aspect with the ad region as an accent block. The format list follows it as a
 * grid of cards, each with a small phone showing where that format lands.
 *
 * Hovering or focusing a card moves and resizes the ad region in BOTH stage
 * phones to that format's geometry — the same code, both platforms, one
 * placement. The geometry is read from --ad-* custom properties that
 * landing.css sets per format slug.
 *
 * There is no JavaScript. The whole interaction is `:has()` + `:hover` /
 * `:focus` in landing.css, so it works with scripting disabled, and every card
 * is a plain anchor that navigates to the format guide when clicked. The
 * resting state is the banner geometry.
 *
 * The stage is `aria-hidden` on purpose: everything it conveys — the format
 * name, what it does, its dimension and its API — is already text in the cards,
 * and the code is the Quick start's code, which the page shows as real text
 * further down. The stage illustrates the list; it is not a second copy of it.
 */
import { formats } from '../../data/landing';
import '../../styles/landing.css';

type Token = [kind: string, text: string];

// App.kt, token by token, so the stage can colour it without a highlighter.
const code: Token[][] = [
  [['annotation', '@Composable']],
  [['keyword', 'fun '], ['function', 'App'], ['plain', '() {']],
  [['plain', '    '], ['keyword', 'val '], ['plain', 'adManager = '], ['function', 'rememberAdManager'], ['plain', '()']],
  [],
  [['plain', '    '], ['function', 'LaunchedEffect'], ['plain', '(adManager) {']],
  [['plain', '        adManager.'], ['function', 'gatherConsentAndInitialize'], ['plain', '(config)']],
  [['plain', '    }']],
  [],
  [['plain', '    '], ['comment', '// one composable, both platforms']],
  [['plain', '    '], ['function', 'BannerAdView'], ['plain', '(placement)']],
  [['plain', '}']],
];

const rows = ['Morning run', 'Reading', 'Sketching', 'Groceries'];
const devices = [
  { platform: 'android', label: 'Android · API 26+' },
  { platform: 'ios', label: 'iOS · 15.0+' },
];
---

{/* Two roots on purpose. `.landing-opening` in Hero.astro is a grid: the stage
    spans the full width under the headline, then the format list follows. */}

<div class="landing-plate__stage" aria-hidden="true">
  <div class="landing-plate__code">
    <div class="landing-plate__code-bar">
      <span class="landing-plate__code-dots"><span></span><span></span><span></span></span>
      <span class="landing-plate__code-file">App.kt</span>
      <span class="landing-plate__code-path">shared/src/commonMain</span>
    </div>
    <pre class="landing-plate__code-body">{code.map((line) => (
      <span class="landing-plate__code-line">{line.map(([kind, text]) => (
        <span class={`landing-plate__syn landing-plate__syn--${kind}`}>{text}</span>
      ))}</span>
    ))}</pre>
  </div>

  <div class="landing-plate__devices">
    {devices.map((device) => (
      <div class={`landing-plate__device landing-plate__device--${device.platform}`}>
        <div class="landing-plate__bezel">
          <div class="landing-plate__viewport">
            <div class="landing-plate__content">
              <span class="landing-plate__appbar">Journal</span>
              {rows.map((row) => (
                <span class="landing-plate__row">{row}</span>
              ))}
            </div>
            <div class="landing-plate__ad">
              <span class="landing-plate__ad-label">Test Ad</span>
            </div>
          </div>
        </div>
        <span class="landing-plate__device-label">{device.label}</span>
      </div>
    ))}
  </div>
</div>

<section class="landing-plate__formats" aria-labelledby="supported-formats">
  <div class="landing-heading">
    <p class="landing-eyebrow">01 · Formats</p>
    <h2 id="supported-formats">Every AdMob format. One call each.</h2>
    <p class="landing-plate__lede">
      Composables for the ads that live in your layout, controllers for the ones that take the
      screen. Each card shows where its format lands.
    </p>
  </div>

  <ol class="landing-formats">
    {formats.map((format) => (
      <li class="landing-format">
        <a href={format.href} data-format={format.slug}>
          <span class="landing-format__phone" aria-hidden="true">
            <span class="landing-format__ad"></span>
          </span>
          <span class="landing-format__text">
            <span class="landing-format__name">{format.name}</span>
            <span class="landing-format__blurb">{format.blurb}</span>
            <span class="landing-format__meta">
              <span class="landing-format__dimension">{format.dimension}</span>
              <code class="admob-font-mono landing-format__api">{format.api}</code>
            </span>
          </span>
        </a>
      </li>
    ))}
  </ol>
</section>
