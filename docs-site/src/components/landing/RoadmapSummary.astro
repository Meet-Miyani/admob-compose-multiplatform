---
/**
 * Two-item roadmap summary rendered as sentence-case semibold headings over
 * plain prose status lines, separated by hairline row borders. No uppercase
 * mono status chips, no pill, no badge.
 */
import { roadmapItems } from '../../data/landing';
import '../../styles/landing.css';
---

<section class="landing-section landing-roadmap">
  <p class="landing-eyebrow">05 · Next</p>
  <h2>Roadmap</h2>
  <dl class="landing-roadmap__list">
    {roadmapItems.map((item) => (
      <div class="landing-roadmap__item">
        <dt class="landing-roadmap__item-title">{item.title}</dt>
        <dd class="landing-roadmap__item-status">{item.status}</dd>
      </div>
    ))}
  </dl>
  <p>
    <a href="/project/roadmap/">Full roadmap →</a>
  </p>
</section>
