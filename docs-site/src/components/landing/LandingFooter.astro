---
/**
 * The landing page's footer: the lockup and attribution on the left, the seven
 * reference links on the right, the trademark line under a hairline.
 *
 * The seven links are literal anchors (no .map) so the hrefs and labels stay
 * greppable here and visible to the tests. Names, URLs and the trademark come
 * from the data module.
 */
import {
  authorName,
  authorUrl,
  repoUrl,
  studioName,
  studioUrl,
  trademarkStatement,
} from '../../data/landing';
import '../../styles/landing.css';
---

<footer class="landing-footer">
  <div class="landing-footer__top">
    <div class="landing-footer__identity">
      <p class="landing-footer__brand">
        <svg class="landing-footer__mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
          <rect x="16.5" y="5.5" width="31" height="53" rx="11" fill="none" stroke="currentColor" stroke-width="9"></rect>
          <rect x="23" y="39" width="18" height="10" rx="5" fill="var(--admob-accent)"></rect>
        </svg>
        <span translate="no">admob-cmp</span>
      </p>
      <p class="landing-footer__author">
        Built by <a href={authorUrl}>{authorName}</a> at <a href={studioUrl}>{studioName}</a>.
      </p>
    </div>
    <nav aria-label="Reference">
      <ul class="landing-footer__links">
        <li><a href="/start/quickstart/">Quickstart</a></li>
        <li><a href="/start/installation/">Installation</a></li>
        <li><a href="/reference/compatibility/">Compatibility</a></li>
        <li><a href="/project/roadmap/">Roadmap</a></li>
        <li><a href="/reference/api/">API reference</a></li>
        <li><a href={repoUrl}>GitHub</a></li>
        <li><a href="https://www.apache.org/licenses/LICENSE-2.0.txt">Apache-2.0 license</a></li>
      </ul>
    </nav>
  </div>
  <p class="landing-footer__legal">{trademarkStatement}</p>
</footer>
