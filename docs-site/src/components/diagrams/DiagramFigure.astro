---
/**
 * Outer chrome shared by every diagram: the figure, the overflow-x scroll
 * region, the caption, the invariant citation, and the link to the diagram's
 * prose equivalent.
 *
 * This is the only place diagrams.css is imported. Astro emits it as a normal
 * unlayered stylesheet, so it beats Starlight's own layered rules.
 */
import '../../styles/diagrams.css';
import { getDiagram } from './descriptions';
import { repoUrl } from '../../data/landing';

interface Props {
  /** Key in descriptions.json. */
  id: string;
  /** Authored viewBox width in SVG user units. Below this the frame scrolls
   *  rather than shrinking the text. Omit for non-SVG content. */
  minWidth?: number;
}

const { id, minWidth } = Astro.props;
const diagram = getDiagram(id);
const invariants = diagram.invariants.map((n) => `#${n}`).join(', ');
// Custom properties inherit, so setting this on the scroll region reaches the SVG.
const scrollStyle = minWidth ? `--dg-min-w:${minWidth}px` : undefined;
---

<figure class="dg-figure" data-diagram={id}>
  <div
    class="dg-scroll"
    tabindex="0"
    role="group"
    aria-label={`${diagram.title} — scrollable diagram`}
    style={scrollStyle}
  >
    <slot />
  </div>
  <figcaption class="dg-caption">
    <span class="dg-caption-title">{diagram.title}</span>
    {/* The numbers cite the library's hard invariants. Linked to the file that
        states them rather than naming it, so the caption reads as a citation
        instead of internal shorthand. */}
    <a class="dg-caption-invariants" href={`${repoUrl}/blob/master/admob-cmp/CLAUDE.md`}>
      Invariants {invariants}
    </a>
    <a class="dg-alt-link" href={`/reference/diagrams-in-words/#${id}`}>
      Read this diagram in words
    </a>
  </figcaption>
</figure>

<script>
  /**
   * Progressive enhancement only. Without this script every diagram is still a
   * keyboard-focusable, horizontally scrollable region — which is why the
   * Expand control is created here rather than rendered server-side: a control
   * that does nothing without JavaScript should not exist in the markup.
   *
   * The scroll region is MOVED into the dialog and moved back on close, never
   * cloned. The Mermaid diagrams carry id-scoped <style> blocks and
   * aria-labelledby references inside their SVG, so a clone would duplicate
   * every one of those ids.
   */
  for (const figure of document.querySelectorAll<HTMLElement>('.dg-figure')) {
    const scroll = figure.querySelector<HTMLElement>('.dg-scroll');
    const caption = figure.querySelector('.dg-caption');
    if (!scroll || !caption) continue;

    const label = scroll.getAttribute('aria-label')?.replace(' — scrollable diagram', '') ?? 'Diagram';

    const dialog = document.createElement('dialog');
    dialog.className = 'dg-dialog';
    dialog.setAttribute('aria-label', label);

    const bar = document.createElement('div');
    bar.className = 'dg-dialog__bar';
    const heading = document.createElement('span');
    heading.className = 'dg-dialog__title';
    heading.textContent = label;
    const close = document.createElement('button');
    close.type = 'button';
    close.className = 'dg-dialog__close';
    close.textContent = 'Close';
    bar.append(heading, close);

    const body = document.createElement('div');
    body.className = 'dg-dialog__body';
    dialog.append(bar, body);
    figure.append(dialog);

    const expand = document.createElement('button');
    expand.type = 'button';
    expand.className = 'dg-expand';
    expand.textContent = 'Expand';
    expand.setAttribute('aria-label', `Expand ${label} to full size`);
    caption.append(expand);

    const anchor = document.createComment('dg-scroll');

    expand.addEventListener('click', () => {
      scroll.replaceWith(anchor);
      body.append(scroll);
      dialog.showModal();
      scroll.focus();
    });

    dialog.addEventListener('close', () => {
      anchor.replaceWith(scroll);
      expand.focus();
    });

    close.addEventListener('click', () => dialog.close());
    // Clicking the backdrop closes; clicking the diagram itself must not.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
